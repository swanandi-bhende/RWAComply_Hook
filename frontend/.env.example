# Optional. Copy to frontend/.env.local and fill with addresses from a local deploy.
# Leave these unset when broadcast/DeployFull.s.sol/31337/run-latest.json exists.
# Names only. Do not put private keys or API secrets in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_POOL_MANAGER=
NEXT_PUBLIC_HOOK_ADDRESS=
NEXT_PUBLIC_ORACLE_ADDRESS=
NEXT_PUBLIC_TOKEN_A_ADDRESS=
NEXT_PUBLIC_TOKEN_B_ADDRESS=
NEXT_PUBLIC_EXECUTOR_ADDRESS=

# World ID server configuration for the Next.js API routes.
# Leave these empty until the Developer Portal values exist.
# WORLD_APP_ID and WORLD_RP_ID are public identifiers.
# WORLD_RP_SIGNING_KEY is a server secret. Do not use a NEXT_PUBLIC_ prefix.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=

# staging or production. Must match the Developer Portal app environment.
WORLD_ID_ENVIRONMENT=

# 32-byte AES-256-GCM key, hex encoded. Do not reuse WORLD_RP_SIGNING_KEY.
# Local generation: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WORLD_SESSION_ENCRYPTION_KEY=

# Optional SQLite file for local enrollment records.
# A local file is enough for the demo. An ephemeral serverless host needs persistent storage.
WORLD_ENROLLMENT_DB_PATH=
